# Copia este archivo como .env y llena los valores.
#
#   cp .env.example .env        (Linux / macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# El .env NO se sube al repositorio (está en .gitignore) porque lleva
# credenciales reales. Este .env.example sí, para que quede constancia de qué
# variables hacen falta.


# ─── Base de datos (OBLIGATORIA) ──────────────────────────────────────────
# Postgres. Sin esto no arranca nada.
DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/nombre_base"


# ─── Sesiones del panel admin (OBLIGATORIA) ───────────────────────────────
# Clave con la que se firman las sesiones. Genera una propia con:
#   npx auth secret
# Si cambia, se cierran todas las sesiones abiertas. NUNCA reutilices la de
# desarrollo en producción.
AUTH_SECRET=

# Solo en producción y solo si el sitio corre detrás de un proxy o balanceador
# (nginx, Traefik, Docker, Railway, Render, NETLIFY...). Sin esto Auth.js puede
# armar mal las URLs de redirección tras el login. En Vercel no hace falta;
# en Netlify SÍ, porque el sitio se sirve desde funciones detrás de su CDN.
# AUTH_TRUST_HOST=true

# La sesión del panel dura 8 horas y el rol se revalida contra la base cada 5
# minutos, así que degradar o eliminar a un usuario le corta el acceso casi de
# inmediato. No hay variable que configurar: está en auth.ts.


# ─── Dominio público del sitio ────────────────────────────────────────────
# Sin barra final. Ej: https://emmacolombia.com.co
# Se usa para el redirect-url del checkout de Wompi. Si se deja vacío se toma
# el origen de la petición, que sirve en local pero puede fallar detrás de un
# proxy. En producción CONVIENE ponerlo.
APP_URL=


# ─── Wompi (pasarela de pago) ─────────────────────────────────────────────
# Se sacan del panel de Wompi, en "Secretos para integración técnica" y
# "Llaves del API para integración técnica".
#
# CUIDADO: las llaves que empiezan por pub_prod_ / prv_prod_ / prod_ son de
# PRODUCCIÓN y cobran plata de verdad. Para probar sin mover dinero, pide las
# de prueba (pub_test_ / prv_test_ / test_events_ / test_integrity_) y usa
# esas mientras desarrollas.
#
# Si estas variables quedan vacías el sitio sigue funcionando: el pedido se
# crea igual, solo que sin link de pago.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
# El código todavía no la usa (solo hace falta para llamar la API de Wompi
# directamente, no para el Web Checkout ya implementado).
WOMPI_PRIVATE_KEY=


# ─── Correo (OPCIONAL — hoy está apagado) ─────────────────────────────────
# Mientras SMTP_USER y SMTP_PASS estén vacíos, el sitio simplemente no manda
# correos y no falla: los pedidos se crean igual y el cliente tiene botones de
# WhatsApp para todo. En cuanto se llenen, el envío se reactiva solo.
#
# NO uses el correo institucional de Microsoft 365: exige apagar Security
# Defaults en todo el tenant, y Microsoft apaga la autenticación básica SMTP a
# fin de 2026. Usa un proveedor transaccional (Brevo, Resend, Amazon SES).
#
# Con Brevo (plan gratis, 300 correos/día):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# OJO: en un proveedor transaccional, SMTP_USER es el identificador de la
# cuenta (algo como 9a1b2c001@smtp-brevo.com), NO el remitente.
SMTP_USER=
SMTP_PASS=

# Remitente que ve quien recibe. Debe ser una dirección verificada en el
# proveedor. Admite nombre visible: "Emma Colombia <pedidos@dominio.com.co>"
SMTP_FROM=

# A dónde llegan las postulaciones y los registros de proveedores. Este SÍ
# puede ser el correo institucional: recibir no tiene restricciones.
SMTP_TO=
